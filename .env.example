# SSO 和门户。不得提交已填充真实凭据的 .env 文件。
UI_SSO_LOGIN_URL=https://ai-test.tucdev.com/user/login?redirect=%2Fuser%2F
UI_PORTAL_URL=https://ai-test.tucdev.com/dashboard
UI_PORTAL_READY_TEXT=AI 数据服务平台首页
UI_AUTHENTICATED_URL_PATTERN=^(?!.*(/login|/signin)).+$

# 测试账号。CI 中应通过密钥注入这些值。
UI_E2E_USERNAME=replace-me
UI_E2E_PASSWORD=replace-me

# 已通过登录页探索确认。登录按钮使用页面对象中的角色与名称定位。
UI_SSO_USERNAME_SELECTOR="#username"
UI_SSO_PASSWORD_SELECTOR="#password"

# 内置二级平台。通过 UI_PLATFORMS_JSON 增加其他平台。
UI_MACHINE_ANNOTATION_URL=https://ai-test.tucdev.com/hawk/project
UI_MACHINE_ANNOTATION_READY_TEXT=项目管理
UI_RESOURCE_MANAGEMENT_URL=https://ai-test.tucdev.com/resource-platform/index
UI_RESOURCE_MANAGEMENT_READY_TEXT=资源列表

# 其他平台配置示例：
# UI_PLATFORMS_JSON=[{"id":"data-governance","name":"数据治理平台","url":"https://governance.example.test/","readyText":"数据治理首页"}]
